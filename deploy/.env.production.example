# Production configuration. Copy to deploy/.env.production (never commit it), fill in, chmod 600.
# Secrets: generate with deploy/generate-secrets.sh (Linux/macOS) or deploy/generate-secrets.ps1 (Windows).
# Used twice: as --env-file (compose variable interpolation) and as env_file of the backend/backup containers.
# With ENV=production the API/worker refuse to start on default/placeholder/short secrets (app.config).

# ---------------------------------------------------------------- domains / URLs
# DNS A records of both names -> this server. Caddy obtains certificates automatically.
API_DOMAIN=api.example.kz
APP_DOMAIN=app.example.kz
# Contact for Let's Encrypt expiry notices
ACME_EMAIL=ops@example.kz
# Public API URL: Meta/Telegram/Twilio webhooks are signed against it; baked into the panel bundle
PUBLIC_BASE_URL=https://api.example.kz
ADMIN_PANEL_URL=https://app.example.kz
CORS_ORIGINS=https://app.example.kz
# Host ports of Caddy (change only for a local test)
HTTP_PORT=80
HTTPS_PORT=443

# ---------------------------------------------------------------- core secrets (REQUIRED, generated)
# >= 32 random chars. Rotation: docs/SECURITY.md §3
JWT_SECRET=
# >= 32 random chars; encrypts integration tokens at rest. Keep a copy OUTSIDE the server and backups.
SECRETS_ENCRYPTION_KEY=
SECRETS_ENCRYPTION_OLD_KEYS=
# >= 16 random chars; per-tenant Telegram webhook secrets are derived from it
TELEGRAM_WEBHOOK_SECRET=
# Optional bearer token for /metrics (>= 24 chars). Empty: only the internal docker network may scrape.
METRICS_TOKEN=

# ---------------------------------------------------------------- database / redis (REQUIRED)
POSTGRES_USER=crm
POSTGRES_DB=crm
# hex only (it is embedded in DATABASE_URL)
POSTGRES_PASSWORD=
REDIS_PASSWORD=
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ---------------------------------------------------------------- AI
# anthropic | mock (mock = deterministic rules, demo only)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Emergency platform-wide AI off-switch: true -> fallback message + admin task for every client message
AI_GLOBALLY_DISABLED=false
# Speech-to-text for WhatsApp voice notes: none (voice notes go to a human) | mock (demo only)
STT_PROVIDER=none

# ---------------------------------------------------------------- WhatsApp Cloud API (Meta)
# live | mock. Per-organization phone_number_id / access token are set in the panel (Integrations).
WHATSAPP_MODE=live
# Meta App -> Settings -> Basic -> App secret (signs webhooks)
WHATSAPP_APP_SECRET=
# Any random string; the same value is entered in Meta App -> WhatsApp -> Configuration -> Verify token
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_CALLING_ENABLED=false

# ---------------------------------------------------------------- Telegram
# live | mock. Bot tokens are per organization (panel -> Integrations -> Telegram)
TELEGRAM_MODE=live

# ---------------------------------------------------------------- Voice (Twilio)
# twilio | mock. Per-organization credentials can also be set in the panel (Integrations -> Calls)
VOICE_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ---------------------------------------------------------------- HTTP hardening
RATE_LIMIT_ENABLED=true
RATE_LIMIT_BACKEND=redis
RATE_LIMIT_LOGIN_PER_MINUTE=20
RATE_LIMIT_WEBHOOK_PER_MINUTE=600
MAX_WEBHOOK_BODY_BYTES=1000000
MAX_REQUEST_BODY_BYTES=10000000
WORKER_CONCURRENCY=4

# ---------------------------------------------------------------- backups (deploy/backup, docs/OPERATIONS.md)
# Daily pg_dump at this UTC hour:minute (21:30 UTC = 02:30 Almaty)
BACKUP_TIME_UTC=21:30
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
# ISO weekday (1=Mon..7=Sun) whose dump is also kept as the weekly copy
BACKUP_WEEKLY_DAY=7
BACKUP_ON_START=true
# Alert (container unhealthy) when the last successful backup is older than this
BACKUP_MAX_AGE_HOURS=26
# Client-side AES-256 encryption of dump files (recommended). Store the passphrase OUTSIDE the server.
BACKUP_PASSPHRASE=
# Optional off-site copy to S3-compatible storage (AWS S3, Yandex Object Storage, MinIO, ...). Empty = local only.
S3_BUCKET=
S3_PREFIX=ai-crm
S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
# Host directory for dumps instead of the named volume (must be writable by uid 70)
# BACKUP_HOST_DIR=/srv/ai-crm/backups

# ---------------------------------------------------------------- images (optional: pinned registry tags)
# BACKEND_IMAGE=registry.example.kz/ai-crm/backend:1.0.0
# FRONTEND_IMAGE=registry.example.kz/ai-crm/frontend:1.0.0
# BACKUP_IMAGE=registry.example.kz/ai-crm/backup:1.0.0
# EDGE_SUBNET=172.30.10.0/24
