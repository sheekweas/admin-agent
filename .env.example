# Copy to .env and fill in. Never commit .env.
ENV=dev
JWT_SECRET=change-me-to-a-long-random-string
PUBLIC_BASE_URL=http://localhost:8000
ADMIN_PANEL_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# AI: "anthropic" uses Claude via ANTHROPIC_API_KEY; "mock" is a deterministic rule-based agent for dev/tests
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# WhatsApp Cloud API (Meta). Per-tenant access tokens / phone_number_id are configured in the panel (Integrations).
WHATSAPP_MODE=mock
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=choose-a-verify-token

# Speech-to-text for WhatsApp voice notes: "mock" (dev) or "none" (voice notes go to a human).
# A real provider plugs in by implementing app.ai.stt.SpeechToText.
STT_PROVIDER=mock

# Telegram: per-tenant bot token is configured in the panel (Integrations)
TELEGRAM_MODE=mock
TELEGRAM_WEBHOOK_SECRET=choose-a-secret

# Voice (admin escalation calls). "twilio" or "mock"
VOICE_PROVIDER=mock
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Security (docs/SECURITY.md). With ENV=production the API/worker refuse to start on default/placeholder secrets.
# Dedicated key for integration secrets at rest (recommended; otherwise derived from JWT_SECRET).
SECRETS_ENCRYPTION_KEY=
SECRETS_ENCRYPTION_OLD_KEYS=
# Per client IP + path, 60 s window; "auto" = Redis if reachable, else in-process memory.
# Load tests from a single IP: raise the limits or set RATE_LIMIT_ENABLED=false.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_BACKEND=auto
RATE_LIMIT_LOGIN_PER_MINUTE=20
RATE_LIMIT_WEBHOOK_PER_MINUTE=600
MAX_WEBHOOK_BODY_BYTES=1000000
MAX_REQUEST_BODY_BYTES=10000000
