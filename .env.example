# Copy to .env and fill in. Never commit .env.
ENV=dev
JWT_SECRET=change-me-to-a-long-random-string
PUBLIC_BASE_URL=http://localhost:8000
ADMIN_PANEL_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# AI: "anthropic" uses Claude via ANTHROPIC_API_KEY; "mock" is a deterministic rule-based agent for dev/tests
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# WhatsApp Cloud API (Meta). Per-tenant access tokens / phone_number_id are configured in the panel (Integrations).
WHATSAPP_MODE=mock
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=choose-a-verify-token

# Telegram: per-tenant bot token is configured in the panel (Integrations)
TELEGRAM_MODE=mock
TELEGRAM_WEBHOOK_SECRET=choose-a-secret

# Voice (admin escalation calls). "twilio" or "mock"
VOICE_PROVIDER=mock
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
